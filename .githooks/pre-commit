#!/usr/bin/env bash
# Auto-format staged files before every commit, then fold any resulting
# changes back into the commit. Installed via `just install-hooks`.
#
# Only formats files staged for this commit (not the whole repo). Note: if a
# file is partially staged (some hunks staged, some not), formatting touches
# the whole working-tree file, so unstaged hunks in that file ride along into
# the commit too — same tradeoff most format-on-commit hooks make.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

mapfile -t staged < <(git diff --cached --name-only --diff-filter=ACMR)
rust_files=()
frontend_files=()
for f in "${staged[@]}"; do
    case "$f" in
        *.rs) [[ -f "$f" ]] && rust_files+=("$f") ;;
        # biome.json's `files.includes` excludes `src-tauri` entirely, and
        # biome exits nonzero if every path it's given is ignored by its own
        # config — so skip src-tauri here rather than pass it files it'll
        # refuse to touch.
        src-tauri/*) ;;
        *.ts | *.tsx | *.js | *.jsx | *.json | *.css) [[ -f "$f" ]] && frontend_files+=("$f") ;;
    esac
done

if [[ ${#rust_files[@]} -eq 0 && ${#frontend_files[@]} -eq 0 ]]; then
    exit 0
fi

status=0
if [[ ${#rust_files[@]} -gt 0 ]]; then
    # rustfmt invoked directly doesn't read Cargo.toml, and cargo fmt would touch
    # every target rather than just the staged files — so pull the edition out of
    # the manifest ourselves (same sed trick the release workflow uses).
    edition="$(sed -n 's/^edition = "\(.*\)"/\1/p' Cargo.toml | head -n1)"
    if [[ -z "$edition" ]]; then
        echo "pre-commit: could not read 'edition' from Cargo.toml" >&2
        exit 1
    fi
    rustfmt --edition "$edition" "${rust_files[@]}" || status=$?
fi
if [[ ${#frontend_files[@]} -gt 0 && $status -eq 0 ]]; then
    # `check --write` also applies assist actions (e.g. organizeImports),
    # which plain `format --write` does not.
    pnpm exec biome check --write "${frontend_files[@]}" >/dev/null || status=$?
fi

if [[ $status -ne 0 ]]; then
    echo "pre-commit: formatting failed, aborting commit" >&2
    exit "$status"
fi

# Re-stage anything the formatters touched so it's part of this commit.
git add -- "${rust_files[@]}" "${frontend_files[@]}"
