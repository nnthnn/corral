{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "remote": {
    "urls": ["http://127.0.0.1:*"]
  },
  "permissions": [
    "core:default",
    "core:window:allow-is-decorated",
    "core:window:allow-close",
    "opener:default",
    "notification:default",
    "clipboard-manager:allow-read-text",
    "clipboard-manager:allow-write-text",
    "clipboard-manager:allow-read-image",
    "dialog:allow-open",
    "allow-notify-icon",
    "allow-send-notification",
    "allow-home-dir",
    "allow-memory-usage",
    "allow-list-projects",
    "allow-project-icon",
    "allow-add-project",
    "allow-remove-project",
    "allow-list-worktrees",
    "allow-set-worktree-note",
    "allow-branch-changes",
    "allow-file-diff",
    "allow-revert-file",
    "allow-list-worktree-dir",
    "allow-read-worktree-file",
    "allow-create-worktree",
    "allow-remove-worktree",
    "allow-rename-worktree",
    "allow-merge-worktree",
    "allow-rebase-worktree",
    "allow-pr-status",
    "allow-pr-checks",
    "allow-pr-details",
    "allow-check-log",
    "allow-merge-pr",
    "allow-mark-pr-ready",
    "allow-watch-worktree",
    "allow-refresh-worktree-status",
    "allow-save-pasted-image",
    "allow-save-text-attachment",
    "allow-open-in-zed",
    "allow-open-terminal",
    "allow-get-settings",
    "allow-save-settings",
    "allow-get-project-settings",
    "allow-save-project-settings",
    "allow-list-sessions",
    "allow-start-session",
    "allow-attach-session",
    "allow-write-session",
    "allow-resize-session",
    "allow-kill-session",
    "allow-close-session",
    "allow-get-provision-output",
    "allow-rerun-provision",
    "allow-stop-provision",
    "allow-resize-provision",
    "allow-start-run",
    "allow-stop-run",
    "allow-get-run-output",
    "allow-resize-run",
    "allow-resolve-run-command",
    "allow-list-run-targets",
    "allow-browser-ui-ready",
    "allow-browser-ui-bounds",
    "allow-browser-tab-new",
    "allow-browser-tab-focus",
    "allow-browser-tab-close",
    "allow-browser-navigate",
    "allow-browser-go-back",
    "allow-browser-go-forward",
    "allow-browser-reload"
  ]
}
