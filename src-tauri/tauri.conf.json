{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Corral",
  "version": "0.5.0",
  "identifier": "dev.corral.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "linux": {
      "deb": {
        "files": {
          "/usr/bin/corral": "../target/release/corral"
        }
      },
      "rpm": {
        "files": {
          "/usr/bin/corral": "../target/release/corral"
        }
      },
      "appimage": {
        "files": {
          "/usr/bin/corral": "../target/release/corral"
        }
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
